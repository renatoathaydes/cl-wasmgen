(in-package #:wasmgen)

(defconstant +wasm-magic-number+ #(#x00 #x61 #x73 #x6d))
(defconstant +wasm-version-1+ #(#x01 #x00 #x00 #x00))

(defconstant +section-id/custom+         0)
(defconstant +section-id/type+           1)
(defconstant +section-id/import+         2)
(defconstant +section-id/function+       3)
(defconstant +section-id/table+          4)
(defconstant +section-id/memory+         5)
(defconstant +section-id/global+         6)
(defconstant +section-id/export+         7)
(defconstant +section-id/start+          8)
(defconstant +section-id/element+        9)
(defconstant +section-id/code+          10)
(defconstant +section-id/data+          11)
(defconstant +section-id/data-count+    12)
(defconstant +section-id/tag+           13)

(defconstant +type/array+   #x5e)
(defconstant +type/struct+  #x5f)
(defconstant +type/func+    #x60)
(defconstant +type/f64+     #x7c)
(defconstant +type/f32+     #x7d)
(defconstant +type/i64+     #x7e)
(defconstant +type/i32+     #x7f)

(defconstant +kind/function+   #x00)
(defconstant +kind/table+      #x01)
(defconstant +kind/memory+     #x02)
(defconstant +kind/global+     #x03)

(defconstant +absheaptype/exn+      #x69)
(defconstant +absheaptype/array+    #x6A)
(defconstant +absheaptype/struct+   #x6B)
(defconstant +absheaptype/i31+      #x6C)
(defconstant +absheaptype/eq+       #x6D)
(defconstant +absheaptype/any+      #x6E)
(defconstant +absheaptype/extern+   #x6F)
(defconstant +absheaptype/func+     #x70)
(defconstant +absheaptype/none+     #x71)
(defconstant +absheaptype/noextern+ #x72)
(defconstant +absheaptype/nofunc+   #x73)
(defconstant +absheaptype/noexn+    #x74)

